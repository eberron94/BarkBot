{
    "name": "barkbot",
    "version": "1.1.0",
    "description": "Cross-posting Telegram bot for Telegram, Tumblr, and Bluesky",
    "type": "module",
    "main": "src/bot.js",
    "scripts": {
        "dev": "nodemon -L --ignore presets.json --ignore memory.json src/bot.js",
        "start": "node src/bot.js",
        "setup": "node scripts/setup.js",
        "check": "node scripts/check-connections.js",
        "setup:pm2": "node scripts/setup-pm2.js"
    },
    "dependencies": {
        "@atproto/api": "latest",
        "adm-zip": "^0.5.17",
        "discord.js": "^14.26.4",
        "dotenv": "latest",
        "telegraf": "latest",
        "tumblr.js": "latest"
    },
    "devDependencies": {
        "nodemon": "^3.1.14"
    }
}
